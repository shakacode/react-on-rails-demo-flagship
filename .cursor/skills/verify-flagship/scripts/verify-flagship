#!/usr/bin/env bash
# Launch, check, drive, and tear down one isolated flagship demo instance for verification.
#
# Usage (from anywhere inside the checkout):
#   verify-flagship launch [--mode hmr|static] [--base-port N]
#                                            start bin/dev on a free port block with a disposable DB
#   verify-flagship doctor [RUN_ID]          read-only: is this instance ours and worth driving?
#   verify-flagship drive FEATURE [RUN_ID]   drive one feature (board|create|update|delete|slow), then reseed
#   verify-flagship reseed [RUN_ID]          converge the run's DB back to the six seeded tasks
#   verify-flagship cleanup [RUN_ID]         stop what launch started, delete scratch, keep evidence
#   verify-flagship status                   list runs and evidence directories
#
# RUN_ID defaults to the most recent launch (tmp/verify-flagship/current).
set -euo pipefail

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
ROOT="$(git -C "$SCRIPT_DIR" rev-parse --show-toplevel)"
VF_DIR="$ROOT/tmp/verify-flagship"
RUNS_DIR="$VF_DIR/runs"
EVIDENCE_ROOT="$VF_DIR/evidence"
READY_TIMEOUT="${VERIFY_FLAGSHIP_READY_TIMEOUT:-300}"

die() { echo "verify-flagship: $*" >&2; exit 1; }
log() { echo "==> $*"; }

port_listeners() { lsof -nP -iTCP:"$1" -sTCP:LISTEN -t 2>/dev/null | sort -u || true; }
pid_alive() { [[ -n "${1:-}" ]] && kill -0 "$1" 2>/dev/null; }
pid_cwd() { lsof -a -p "$1" -d cwd -Fn 2>/dev/null | sed -n 's/^n//p' | head -1; }

resolve_run() {
  local run_id="${1:-}"
  if [[ -z "$run_id" ]]; then
    [[ -f "$VF_DIR/current" ]] || die "no current run; pass RUN_ID or run 'launch' first"
    run_id="$(cat "$VF_DIR/current")"
  fi
  RUN_DIR="$RUNS_DIR/$run_id"
  [[ -f "$RUN_DIR/state.env" ]] || die "run $run_id has no state at $RUN_DIR/state.env (already cleaned up?)"
  # shellcheck disable=SC1091
  source "$RUN_DIR/state.env"
}

ports_free() {
  local port
  for port in "$@"; do [[ -z "$(port_listeners "$port")" ]] || return 1; done
}

cmd_launch() {
  local base_port="" mode="hmr"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --base-port) base_port="$2"; shift 2 ;;
      --mode) mode="$2"; shift 2 ;;
      *) die "unknown launch option: $1" ;;
    esac
  done
  local bin_dev_args=(--no-open-browser)
  case "$mode" in
    hmr) ;;
    static) bin_dev_args=(static --no-open-browser) ;;
    *) die "--mode must be hmr or static" ;;
  esac

  # One instance per checkout: Puma's tmp/pids/server.pid, public/packs, ssr-generated,
  # and .node-renderer-bundles are shared by every bin/dev started from this directory.
  if [[ -f "$ROOT/tmp/pids/server.pid" ]] && pid_alive "$(cat "$ROOT/tmp/pids/server.pid")"; then
    die "a Rails server from this checkout is already running (tmp/pids/server.pid=$(cat "$ROOT/tmp/pids/server.pid")). Refusing to double-drive it; use a separate worktree."
  fi

  if [[ -z "$base_port" ]]; then
    for candidate in $(seq 4710 3 4797); do
      if ports_free "$candidate" "$((candidate + 1))" "$((candidate + 2))"; then base_port="$candidate"; break; fi
    done
    [[ -n "$base_port" ]] || die "no free port block between 4710 and 4799"
  fi
  ports_free "$base_port" "$((base_port + 1))" "$((base_port + 2))" ||
    die "port block $base_port-$((base_port + 2)) is in use; pick another --base-port"

  local run_id
  run_id="$(date -u +%Y%m%dT%H%M%SZ)-$$"
  RUN_DIR="$RUNS_DIR/$run_id"
  local evidence_dir="$EVIDENCE_ROOT/$run_id"
  mkdir -p "$RUN_DIR" "$evidence_dir"

  # Unix sockets are limited to ~104 bytes on macOS, so overmind's socket lives in /tmp.
  local overmind_socket="/tmp/verify-flagship-$run_id.sock"
  local database_url="sqlite3:$RUN_DIR/verify.sqlite3"

  cat >"$RUN_DIR/state.env" <<EOF
RUN_ID='$run_id'
ROOT='$ROOT'
BASE_PORT='$base_port'
RAILS_PORT='$base_port'
WEBPACK_PORT='$((base_port + 1))'
RENDERER_PORT_USED='$((base_port + 2))'
BASE_URL='http://localhost:$base_port'
LAUNCH_MODE='$mode'
DATABASE_URL_USED='$database_url'
OVERMIND_SOCKET_USED='$overmind_socket'
EVIDENCE_DIR='$evidence_dir'
LAUNCH_LOG='$RUN_DIR/bin-dev.log'
GIT_HEAD='$(git -C "$ROOT" rev-parse HEAD)'
EOF
  echo "$run_id" >"$VF_DIR/current"

  log "run $run_id: ports $base_port/$((base_port + 1))/$((base_port + 2)), db $RUN_DIR/verify.sqlite3"
  log "evidence will be kept in $evidence_dir"

  # These variables must be in the environment *before* bin/dev starts: bin/dev's own
  # ENV["ALLOW_DEMO_RENDERER_PASSWORD"] ||= "true" is dropped by the pack generator's
  # Bundler.with_unbundled_env, so a bare `bin/dev` fails with
  # "KeyError: RENDERER_PASSWORD is required unless ALLOW_DEMO_RENDERER_PASSWORD=true".
  export ALLOW_DEMO_RENDERER_PASSWORD=true
  export REACT_ON_RAILS_BASE_PORT="$base_port"
  export DATABASE_URL="$database_url"
  export OVERMIND_SOCKET="$overmind_socket"

  log "preparing and seeding the disposable database"
  (cd "$ROOT" && bin/rails db:prepare db:seed) >"$RUN_DIR/db-setup.log" 2>&1 ||
    { cat "$RUN_DIR/db-setup.log" >&2; die "db:prepare db:seed failed (log: $RUN_DIR/db-setup.log)"; }

  log "starting bin/dev ${bin_dev_args[*]}"
  (cd "$ROOT" && exec nohup bin/dev "${bin_dev_args[@]}") >"$RUN_DIR/bin-dev.log" 2>&1 &
  local bin_dev_pid=$!
  echo "BIN_DEV_PID='$bin_dev_pid'" >>"$RUN_DIR/state.env"

  log "waiting up to ${READY_TIMEOUT}s for bin/smoke to pass at http://localhost:$base_port"
  local deadline=$((SECONDS + READY_TIMEOUT))
  until (cd "$ROOT" && SMOKE_URL="http://localhost:$base_port" SMOKE_WAIT_SECONDS=2 bin/smoke) >"$RUN_DIR/smoke.log" 2>&1; do
    if ! pid_alive "$bin_dev_pid"; then
      tail -40 "$RUN_DIR/bin-dev.log" >&2
      die "bin/dev exited before the app was ready (log: $RUN_DIR/bin-dev.log). Run 'cleanup $run_id'."
    fi
    if ((SECONDS >= deadline)); then
      tail -40 "$RUN_DIR/bin-dev.log" >&2
      die "app not ready after ${READY_TIMEOUT}s (log: $RUN_DIR/bin-dev.log). Run 'cleanup $run_id'."
    fi
    sleep 3
  done
  cat "$RUN_DIR/smoke.log"
  record_process_manager "$bin_dev_pid"
  log "READY run=$run_id mode=$mode url=http://localhost:$base_port"
}

# Overmind runs Procfile processes inside its own tmux server, which re-parents to PID 1,
# so record both PIDs now; cleanup waits for exactly these to exit.
record_process_manager() {
  local pid command tmux_name tmux_pid
  for pid in $(pgrep -P "$1" || true); do
    command="$(ps -o command= -p "$pid" || true)"
    case "$command" in
      overmind\ start*)
        echo "PROCESS_MANAGER_PID='$pid'" >>"$RUN_DIR/state.env"
        tmux_name="$(pgrep -P "$pid" | xargs -I{} ps -o command= -p {} | sed -n 's/.*tmux .*-L \([^ ]*\).*/\1/p' | head -1)"
        if [[ -n "$tmux_name" ]]; then
          tmux_pid="$(tmux -L "$tmux_name" display-message -p '#{pid}' 2>/dev/null || true)"
          echo "TMUX_SERVER_PID='$tmux_pid'" >>"$RUN_DIR/state.env"
        fi ;;
      foreman*) echo "PROCESS_MANAGER_PID='$pid'" >>"$RUN_DIR/state.env" ;;
    esac
  done
}

cmd_doctor() {
  resolve_run "${1:-}"
  local failures=0
  check() { if eval "$2"; then echo "[ok]   $1"; else echo "[FAIL] $1"; failures=$((failures + 1)); fi; }

  echo "run $RUN_ID at $BASE_URL, mode ${LAUNCH_MODE:-hmr} (launched from $GIT_HEAD)"
  check "bin/dev process $BIN_DEV_PID is alive" "pid_alive '$BIN_DEV_PID'"

  local listener
  listener="$(port_listeners "$RAILS_PORT" | head -1)"
  check "something listens on :$RAILS_PORT" "[[ -n '$listener' ]]"
  if [[ -n "$listener" ]]; then
    check "listener $listener on :$RAILS_PORT runs from $ROOT" "[[ \"\$(pid_cwd $listener)\" == '$ROOT' ]]"
  fi
  # Prove the server reads this run's database, not storage/development.sqlite3: the rows the
  # API serves must match the run DB's (id, updated_at) pairs, which the launch seed stamped.
  local db_rows api_rows
  db_rows="$(sqlite3 -readonly "${DATABASE_URL_USED#sqlite3:}" \
    "select id || ' ' || substr(replace(updated_at, ' ', 'T'), 1, 19) from tasks order by id" 2>/dev/null || true)"
  api_rows="$(curl -fsS "$BASE_URL/api/tasks" 2>/dev/null | node -e \
    'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{for(const t of JSON.parse(s).tasks.sort((a,b)=>a.id-b.id))console.log(`${t.id} ${t.updatedAt.slice(0,19)}`)})' \
    2>/dev/null || true)"
  check "/api/tasks serves this run's database (${DATABASE_URL_USED#sqlite3:})" "[[ -n '$db_rows' && '$db_rows' == '$api_rows' ]]"
  check "node renderer listens on :$RENDERER_PORT_USED" "[[ -n \"\$(port_listeners $RENDERER_PORT_USED)\" ]]"

  local deployment expected_pro
  deployment="$(curl -fsS "$BASE_URL/__deployment" 2>/dev/null || true)"
  expected_pro="$(sed -n 's/^    react_on_rails_pro (\(.*\))$/\1/p' "$ROOT/Gemfile.lock" | head -1)"
  check "/__deployment reports react_on_rails_pro $expected_pro" \
    "[[ '$deployment' == *'\"react_on_rails_pro\":\"$expected_pro\"'* ]]"
  check "checkout HEAD still matches launch ($GIT_HEAD)" "[[ \"\$(git -C '$ROOT' rev-parse HEAD)\" == '$GIT_HEAD' ]]"
  check "bin/smoke passes (streamed RSC board with seeded title)" \
    "(cd '$ROOT' && SMOKE_URL='$BASE_URL' SMOKE_WAIT_SECONDS=5 bin/smoke >/dev/null 2>&1)"

  if ((failures > 0)); then echo "doctor: $failures check(s) failed; do not drive this instance"; return 1; fi
  echo "doctor: healthy"
}

cmd_reseed() {
  resolve_run "${1:-}"
  (cd "$ROOT" && ALLOW_DEMO_RENDERER_PASSWORD=true DATABASE_URL="$DATABASE_URL_USED" bin/rails db:seed)
}

cmd_drive() {
  local feature="${1:-}"
  [[ -n "$feature" ]] || die "usage: drive FEATURE [RUN_ID]"
  resolve_run "${2:-}"
  local status=0
  (cd "$ROOT" && VERIFY_BASE_URL="$BASE_URL" VERIFY_EVIDENCE_DIR="$EVIDENCE_DIR" VERIFY_RUN_ID="$RUN_ID" \
    VERIFY_GIT_HEAD="$GIT_HEAD" VERIFY_LAUNCH_MODE="${LAUNCH_MODE:-hmr}" node "$SCRIPT_DIR/drive.mjs" "$feature") || status=$?
  log "restoring seed data"
  cmd_reseed "$RUN_ID" >/dev/null
  return "$status"
}

cmd_cleanup() {
  resolve_run "${1:-}"
  log "cleaning up run $RUN_ID"

  # Keep the launch log with the evidence before scratch state is removed.
  mkdir -p "$EVIDENCE_DIR"
  for f in bin-dev.log db-setup.log smoke.log; do
    [[ -f "$RUN_DIR/$f" ]] && cp "$RUN_DIR/$f" "$EVIDENCE_DIR/launch-$f"
  done

  # Stop bin/dev first: when overmind exits, ReactOnRails::Dev::ProcessManager falls back to
  # foreman and restarts every process, so the parent must already be gone.
  if pid_alive "${BIN_DEV_PID:-}"; then
    log "stopping bin/dev pid $BIN_DEV_PID"
    kill -TERM "$BIN_DEV_PID" 2>/dev/null || true
  fi
  if [[ -S "$OVERMIND_SOCKET_USED" ]]; then
    log "asking overmind to quit (socket $OVERMIND_SOCKET_USED)"
    overmind quit -s "$OVERMIND_SOCKET_USED" >/dev/null 2>&1 || true
  fi

  local ports=("$RAILS_PORT" "$WEBPACK_PORT" "$RENDERER_PORT_USED") deadline=$((SECONDS + 30)) pid
  until ports_free "${ports[@]}"; do
    if ((SECONDS >= deadline)); then
      # Only processes that run from this checkout and hold this run's ports are ours.
      for port in "${ports[@]}"; do
        for pid in $(port_listeners "$port"); do
          if [[ "$(pid_cwd "$pid")" == "$ROOT"* ]]; then
            log "terminating leftover listener pid $pid on :$port"
            kill -TERM "$pid" 2>/dev/null || true
          else
            echo "verify-flagship: :$port is held by pid $pid outside $ROOT; leaving it alone" >&2
          fi
        done
      done
      sleep 3
      ports_free "${ports[@]}" || die "ports ${ports[*]} still in use after cleanup; inspect with lsof"
      break
    fi
    sleep 1
  done
  if pid_alive "${BIN_DEV_PID:-}"; then die "bin/dev pid $BIN_DEV_PID is still alive"; fi

  # Overmind drains its panes (the node renderer exits last) before it and its tmux server stop.
  local manager_pids=("${PROCESS_MANAGER_PID:-}" "${TMUX_SERVER_PID:-}")
  deadline=$((SECONDS + 45))
  for pid in "${manager_pids[@]}"; do
    while pid_alive "$pid"; do
      if ((SECONDS >= deadline)); then
        log "terminating process manager pid $pid recorded at launch"
        kill -TERM "$pid" 2>/dev/null || true
        sleep 2
        pid_alive "$pid" && die "process manager pid $pid is still alive"
        break
      fi
      sleep 1
    done
  done

  rm -f "$OVERMIND_SOCKET_USED"
  rm -rf "$RUN_DIR"
  if [[ -f "$VF_DIR/current" && "$(cat "$VF_DIR/current")" == "$RUN_ID" ]]; then rm -f "$VF_DIR/current"; fi

  [[ -d "$EVIDENCE_DIR" ]] || die "evidence directory $EVIDENCE_DIR is missing after cleanup"
  log "ports ${ports[*]} are free; scratch state removed"
  log "evidence kept in $EVIDENCE_DIR:"
  (cd "$EVIDENCE_DIR" && find . -type f | sort)
}

cmd_status() {
  echo "current: $(cat "$VF_DIR/current" 2>/dev/null || echo none)"
  echo "runs:";     /bin/ls -1 "$RUNS_DIR" 2>/dev/null | sed 's/^/  /' || true
  echo "evidence:"; /bin/ls -1 "$EVIDENCE_ROOT" 2>/dev/null | sed 's/^/  /' || true
}

command="${1:-}"
shift || true
case "$command" in
  launch) cmd_launch "$@" ;;
  doctor) cmd_doctor "$@" ;;
  drive) cmd_drive "$@" ;;
  reseed) cmd_reseed "$@" ;;
  cleanup) cmd_cleanup "$@" ;;
  status) cmd_status ;;
  *) sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; [[ -z "$command" ]] || exit 1 ;;
esac
