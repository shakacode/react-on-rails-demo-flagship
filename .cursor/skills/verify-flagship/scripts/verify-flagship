#!/usr/bin/env bash
# Launch, check, drive, and tear down one isolated flagship demo instance for verification.
#
# Usage (from anywhere inside the checkout):
#   verify-flagship launch [--mode hmr|static] [--base-port N]
#                                            start bin/dev on a free port block with a disposable DB
#   verify-flagship doctor [RUN_ID]          read-only: is this instance ours and worth driving?
#   verify-flagship drive FEATURE [RUN_ID]   drive one feature (board|create|update|delete|slow), then reseed
#   verify-flagship reseed [RUN_ID]          converge the run's DB back to the six seeded tasks
#   verify-flagship cleanup [RUN_ID]         stop what launch started, delete scratch, keep evidence
#   verify-flagship status                   list runs and evidence directories
#
# RUN_ID defaults to the most recent launch (tmp/verify-flagship/current).
set -euo pipefail

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
ROOT="$(git -C "$SCRIPT_DIR" rev-parse --show-toplevel)"
VF_DIR="$ROOT/tmp/verify-flagship"
RUNS_DIR="$VF_DIR/runs"
EVIDENCE_ROOT="$VF_DIR/evidence"
READY_TIMEOUT="${VERIFY_FLAGSHIP_READY_TIMEOUT:-300}"
# Rails prefers this over DATABASE_URL, so an inherited value would seed someone else's database.
unset PRIMARY_DATABASE_URL

die() { echo "verify-flagship: $*" >&2; exit 1; }
log() { echo "==> $*"; }

port_listeners() { lsof -nP -iTCP:"$1" -sTCP:LISTEN -t 2>/dev/null | sort -u || true; }
pid_alive() { [[ -n "${1:-}" ]] && kill -0 "$1" 2>/dev/null; }
pid_cwd() { lsof -a -p "$1" -d cwd -Fn 2>/dev/null | sed -n 's/^n//p' | head -1; }
pid_start() { ps -o lstart= -p "$1" 2>/dev/null | sed 's/^ *//; s/ *$//'; }

# Ownership ledger: <run>/owned.tsv holds "PID<TAB>start time<TAB>role" for every process this
# run started. A PID counts as ours only while its start time still matches, so a reused PID
# or a later process on the same port is never signalled.
own() {
  local pid="$1" role="$2" start
  [[ -n "$pid" ]] || return 0
  start="$(pid_start "$pid")"
  [[ -n "$start" ]] || return 0
  if ! cut -f1 "$RUN_DIR/owned.tsv" 2>/dev/null | grep -qx "$pid"; then
    printf '%s\t%s\t%s\n' "$pid" "$start" "$role" >>"$RUN_DIR/owned.tsv"
  fi
}
owned_pids() { cut -f1 "$RUN_DIR/owned.tsv" 2>/dev/null || true; }
owned_role_pids() { awk -F'\t' -v r="$1" '$3 == r { print $1 }' "$RUN_DIR/owned.tsv" 2>/dev/null || true; }
still_ours() {
  local pid="$1" recorded
  [[ -n "$pid" ]] || return 1
  recorded="$(awk -F'\t' -v p="$pid" '$1 == p { print $2 }' "$RUN_DIR/owned.tsv" 2>/dev/null)"
  [[ -n "$recorded" && "$(pid_start "$pid")" == "$recorded" ]]
}
descends_from_owned() {
  local pid="$1" owners
  owners=" $(owned_pids | tr '\n' ' ') "
  while [[ -n "$pid" && "$pid" -gt 1 ]]; do
    [[ "$owners" == *" $pid "* ]] && still_ours "$pid" && return 0
    pid="$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ')"
  done
  return 1
}

# Port and ownership checks read lsof, so a missing tool must stop the run: without lsof every
# port would look free and cleanup would report success without checking anything.
require_tools() {
  local tool missing=""
  for tool in "$@"; do command -v "$tool" >/dev/null 2>&1 || missing+=" $tool"; done
  [[ -z "$missing" ]] || die "missing required tools:$missing. See Launch prerequisites in SKILL.md."
}

resolve_run() {
  local run_id="${1:-}"
  if [[ -z "$run_id" ]]; then
    [[ -f "$VF_DIR/current" ]] || die "no current run; pass RUN_ID or run 'launch' first"
    run_id="$(cat "$VF_DIR/current")"
  fi
  # Only IDs launch generates; cleanup deletes RUN_DIR, so nothing like ../ may reach it.
  [[ "$run_id" =~ ^[0-9]{8}T[0-9]{6}Z-[0-9]+$ ]] || die "invalid RUN_ID '$run_id'"
  RUN_DIR="$RUNS_DIR/$run_id"
  [[ -f "$RUN_DIR/state.env" ]] || die "run $run_id has no state at $RUN_DIR/state.env (already cleaned up?)"
  # shellcheck disable=SC1091
  source "$RUN_DIR/state.env"
}

ports_free() {
  local port
  for port in "$@"; do [[ -z "$(port_listeners "$port")" ]] || return 1; done
}

cmd_launch() {
  local base_port="" mode="hmr"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --base-port) base_port="$2"; shift 2 ;;
      --mode) mode="$2"; shift 2 ;;
      *) die "unknown launch option: $1" ;;
    esac
  done
  local bin_dev_args=(--no-open-browser)
  case "$mode" in
    hmr) ;;
    static) bin_dev_args=(static --no-open-browser) ;;
    *) die "--mode must be hmr or static" ;;
  esac

  # One instance per checkout: Puma's tmp/pids/server.pid, public/packs, ssr-generated,
  # and .node-renderer-bundles are shared by every bin/dev started from this directory.
  local server_pid=""
  [[ -f "$ROOT/tmp/pids/server.pid" ]] && server_pid="$(cat "$ROOT/tmp/pids/server.pid")"
  if pid_alive "$server_pid" && [[ "$(pid_cwd "$server_pid")" == "$ROOT" ]]; then
    die "a Rails server from this checkout is already running (tmp/pids/server.pid=$(cat "$ROOT/tmp/pids/server.pid")). Refusing to double-drive it; use a separate worktree."
  fi

  # Overmind loads ~/.overmind.env, ./.overmind.env, ./.env, and $OVERMIND_ENV files over this
  # script's exports (and those files can chain more via OVERMIND_ENV); foreman loads ./.env and
  # ./.foreman. Any of them can redirect the database, ports, or overmind's socket, so the run
  # loads none: refuse if one exists, and drop inherited OVERMIND_* settings below.
  local env_file
  for env_file in "$HOME/.overmind.env" "$ROOT/.overmind.env" "$ROOT/.env" "$ROOT/.foreman"; do
    [[ -e "$env_file" ]] &&
      die "$env_file exists; foreman and overmind would load it over this run's isolated settings. Launch from a worktree without it, or move it aside for the run."
  done

  if [[ -n "$base_port" ]]; then
    # Leading zeros would be read as octal by $(( )), so require a plain decimal port.
    [[ "$base_port" =~ ^[1-9][0-9]{0,4}$ ]] && ((base_port <= 65533)) ||
      die "--base-port must be a decimal port between 1 and 65533"
  else
    for candidate in $(seq 4710 3 4797); do
      if ports_free "$candidate" "$((candidate + 1))" "$((candidate + 2))"; then base_port="$candidate"; break; fi
    done
    [[ -n "$base_port" ]] || die "no free port block between 4710 and 4799"
  fi
  ports_free "$base_port" "$((base_port + 1))" "$((base_port + 2))" ||
    die "port block $base_port-$((base_port + 2)) is in use; pick another --base-port"

  local run_id
  run_id="$(date -u +%Y%m%dT%H%M%SZ)-$$"
  RUN_DIR="$RUNS_DIR/$run_id"
  local evidence_dir="$EVIDENCE_ROOT/$run_id"
  mkdir -p "$RUN_DIR" "$evidence_dir"

  # Unix sockets are limited to ~104 bytes on macOS, so overmind's socket lives in /tmp.
  local overmind_socket="/tmp/verify-flagship-$run_id.sock"
  local database_url="sqlite3:$RUN_DIR/verify.sqlite3"

  # %q keeps a checkout path with quotes or spaces safe to source.
  {
    printf 'RUN_ID=%q\n' "$run_id"
    printf 'ROOT=%q\n' "$ROOT"
    printf 'RAILS_PORT=%q\n' "$base_port"
    printf 'WEBPACK_PORT=%q\n' "$((base_port + 1))"
    printf 'RENDERER_PORT_USED=%q\n' "$((base_port + 2))"
    printf 'BASE_URL=%q\n' "http://localhost:$base_port"
    printf 'LAUNCH_MODE=%q\n' "$mode"
    printf 'DATABASE_URL_USED=%q\n' "$database_url"
    printf 'OVERMIND_SOCKET_USED=%q\n' "$overmind_socket"
    printf 'EVIDENCE_DIR=%q\n' "$evidence_dir"
    printf 'LAUNCH_LOG=%q\n' "$RUN_DIR/bin-dev.log"
    printf 'GIT_HEAD=%q\n' "$(git -C "$ROOT" rev-parse HEAD)"
  } >"$RUN_DIR/state.env"
  # shellcheck disable=SC1091
  source "$RUN_DIR/state.env"
  echo "$run_id" >"$VF_DIR/current"

  log "run $run_id: ports $base_port/$((base_port + 1))/$((base_port + 2)), db $RUN_DIR/verify.sqlite3"
  log "evidence will be kept in $evidence_dir"

  # These variables must be in the environment *before* bin/dev starts: bin/dev's own
  # ENV["ALLOW_DEMO_RENDERER_PASSWORD"] ||= "true" is dropped by the pack generator's
  # Bundler.with_unbundled_env, so a bare `bin/dev` fails with
  # "KeyError: RENDERER_PASSWORD is required unless ALLOW_DEMO_RENDERER_PASSWORD=true".
  export ALLOW_DEMO_RENDERER_PASSWORD=true
  export REACT_ON_RAILS_BASE_PORT="$base_port"
  export DATABASE_URL="$database_url"
  local inherited
  for inherited in $(compgen -e | grep '^OVERMIND_' || true); do unset "$inherited"; done
  export OVERMIND_SOCKET="$overmind_socket"

  log "preparing and seeding the disposable database"
  (cd "$ROOT" && bin/rails db:prepare db:seed) >"$RUN_DIR/db-setup.log" 2>&1 ||
    { cat "$RUN_DIR/db-setup.log" >&2; die "db:prepare db:seed failed (log: $RUN_DIR/db-setup.log)"; }

  log "starting bin/dev ${bin_dev_args[*]}"
  (cd "$ROOT" && exec nohup bin/dev "${bin_dev_args[@]}") >"$RUN_DIR/bin-dev.log" 2>&1 &
  local bin_dev_pid=$!
  printf 'BIN_DEV_PID=%q\n' "$bin_dev_pid" >>"$RUN_DIR/state.env"
  own "$bin_dev_pid" bin-dev

  log "waiting up to ${READY_TIMEOUT}s for bin/smoke to pass at http://localhost:$base_port"
  local deadline=$((SECONDS + READY_TIMEOUT))
  until (cd "$ROOT" && SMOKE_URL="http://localhost:$base_port" SMOKE_WAIT_SECONDS=2 bin/smoke) >"$RUN_DIR/smoke.log" 2>&1; do
    # Record the process manager as soon as it appears, so a failed launch can still be cleaned up.
    record_process_manager "$bin_dev_pid"
    if ! pid_alive "$bin_dev_pid"; then
      tail -40 "$RUN_DIR/bin-dev.log" >&2
      die "bin/dev exited before the app was ready (log: $RUN_DIR/bin-dev.log). Run 'cleanup $run_id'."
    fi
    if ((SECONDS >= deadline)); then
      tail -40 "$RUN_DIR/bin-dev.log" >&2
      die "app not ready after ${READY_TIMEOUT}s (log: $RUN_DIR/bin-dev.log). Run 'cleanup $run_id'."
    fi
    sleep 3
  done
  cat "$RUN_DIR/smoke.log"
  record_process_manager "$bin_dev_pid"
  # bin/dev falls back to foreman when overmind fails, a path this skill has never been proven on.
  [[ -n "$(owned_role_pids tmux-server)" ]] ||
    die "bin/dev is not running under overmind, the only process manager this skill supports. Run 'cleanup $run_id' and check $RUN_DIR/bin-dev.log."
  record_listeners
  log "READY run=$run_id mode=$mode url=http://localhost:$base_port"
}

# Overmind runs Procfile processes inside its own tmux server, which re-parents to PID 1,
# so record the manager and that server; cleanup waits for exactly these to exit.
record_process_manager() {
  local pid command child tmux_name=""
  [[ -z "$(owned_role_pids tmux-server)" ]] || return 0
  for pid in $(pgrep -P "$1" 2>/dev/null || true); do
    command="$(ps -o command= -p "$pid" 2>/dev/null || true)"
    case "$command" in
      overmind\ start*)
        own "$pid" process-manager
        for child in $(pgrep -P "$pid" 2>/dev/null || true); do
          tmux_name="$(ps -o command= -p "$child" 2>/dev/null | sed -n 's/.*tmux .*-L \([^ ]*\).*/\1/p' || true)"
          [[ -n "$tmux_name" ]] && break
        done
        if [[ -n "$tmux_name" ]]; then
          own "$(tmux -L "$tmux_name" display-message -p '#{pid}' 2>/dev/null || true)" tmux-server
        fi ;;
      foreman*) own "$pid" process-manager ;;
    esac
  done
}

# At READY the run's ports were free before launch and are now held by descendants of the
# processes above; record those listeners so cleanup can stop them if they outlive the manager.
record_listeners() {
  local port pid
  for port in "$RAILS_PORT" "$WEBPACK_PORT" "$RENDERER_PORT_USED"; do
    for pid in $(port_listeners "$port"); do
      if descends_from_owned "$pid"; then own "$pid" "listener:$port"; fi
    done
  done
}

# Doctor checks run as plain commands; app responses are compared as data, never evaluated.
cwd_is_root() { [[ "$(pid_cwd "$1")" == "$ROOT" ]]; }
equal_nonempty() { [[ -n "$1" && "$1" == "$2" ]]; }
contains() { [[ "$1" == *"$2"* ]]; }
head_unchanged() { [[ "$(git -C "$ROOT" rev-parse HEAD)" == "$GIT_HEAD" ]]; }
# Every listener on the port must be a recorded process or descend from one (renderer workers restart).
listeners_ours() {
  local pid pids
  pids="$(port_listeners "$1")"
  [[ -n "$pids" ]] || return 1
  for pid in $pids; do descends_from_owned "$pid" || return 1; done
}
smoke_passes() { (cd "$ROOT" && SMOKE_URL="$BASE_URL" SMOKE_WAIT_SECONDS=5 bin/smoke >/dev/null 2>&1); }

cmd_doctor() {
  resolve_run "${1:-}"
  local failures=0
  check() {
    local name="$1"; shift
    if "$@"; then echo "[ok]   $name"; else echo "[FAIL] $name"; failures=$((failures + 1)); fi
  }

  echo "run $RUN_ID at $BASE_URL, mode ${LAUNCH_MODE:-hmr} (launched from $GIT_HEAD)"
  check "bin/dev process $BIN_DEV_PID is alive and is the one launch started" still_ours "$BIN_DEV_PID"

  local listener
  listener="$(port_listeners "$RAILS_PORT" | head -1)"
  check "Rails listeners on :$RAILS_PORT were started by this run" listeners_ours "$RAILS_PORT"
  if [[ -n "$listener" ]]; then check "Rails listener $listener runs from $ROOT" cwd_is_root "$listener"; fi
  # Prove the server reads this run's database, not storage/development.sqlite3: the rows the
  # API serves must match the run DB's (id, updated_at) pairs, which the launch seed stamped.
  local db_rows api_rows
  db_rows="$(sqlite3 -readonly "${DATABASE_URL_USED#sqlite3:}" \
    "select id || ' ' || substr(replace(updated_at, ' ', 'T'), 1, 19) from tasks order by id" 2>/dev/null || true)"
  api_rows="$(curl -fsS "$BASE_URL/api/tasks" 2>/dev/null | node -e \
    'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{for(const t of JSON.parse(s).tasks.sort((a,b)=>a.id-b.id))console.log(`${t.id} ${t.updatedAt.slice(0,19)}`)})' \
    2>/dev/null || true)"
  if [[ "${LAUNCH_MODE:-hmr}" == hmr ]]; then
    check "webpack dev server listeners on :$WEBPACK_PORT were started by this run" listeners_ours "$WEBPACK_PORT"
  fi
  check "/api/tasks serves this run's database (${DATABASE_URL_USED#sqlite3:})" equal_nonempty "$db_rows" "$api_rows"
  check "node renderer listeners on :$RENDERER_PORT_USED were started by this run" listeners_ours "$RENDERER_PORT_USED"

  local deployment expected_pro
  deployment="$(curl -fsS "$BASE_URL/__deployment" 2>/dev/null || true)"
  expected_pro="$(sed -n 's/^    react_on_rails_pro (\(.*\))$/\1/p' "$ROOT/Gemfile.lock" | head -1)"
  check "/__deployment reports react_on_rails_pro $expected_pro" contains "$deployment" "\"react_on_rails_pro\":\"$expected_pro\""
  check "checkout HEAD still matches launch ($GIT_HEAD)" head_unchanged
  check "bin/smoke passes (streamed RSC board with seeded title)" smoke_passes

  if ((failures > 0)); then echo "doctor: $failures check(s) failed; do not drive this instance"; return 1; fi
  echo "doctor: healthy"
}

cmd_reseed() {
  resolve_run "${1:-}"
  (cd "$ROOT" && ALLOW_DEMO_RENDERER_PASSWORD=true DATABASE_URL="$DATABASE_URL_USED" bin/rails db:seed)
}

cmd_drive() {
  local feature="${1:-}"
  [[ -n "$feature" ]] || die "usage: drive FEATURE [RUN_ID]"
  resolve_run "${2:-}"
  # One drive per run at a time: a second drive's reseed would reset rows mid-journey.
  local lock="$RUN_DIR/drive.lock"
  mkdir "$lock" 2>/dev/null || die "another drive is running on run $RUN_ID (remove $lock if it is stale)"
  # Expand the path now: the local variable is gone by the time the EXIT trap runs.
  trap "rmdir $(printf %q "$lock") 2>/dev/null" EXIT
  # Never mutate an instance that is not provably this run's (wrong DB, foreign port owner, ...).
  cmd_doctor "$RUN_ID" >"$RUN_DIR/doctor-before-drive.log" 2>&1 ||
    { cat "$RUN_DIR/doctor-before-drive.log" >&2; die "doctor failed; refusing to drive $feature"; }
  local status=0
  (cd "$ROOT" && VERIFY_BASE_URL="$BASE_URL" VERIFY_EVIDENCE_DIR="$EVIDENCE_DIR" VERIFY_RUN_ID="$RUN_ID" \
    VERIFY_GIT_HEAD="$GIT_HEAD" VERIFY_LAUNCH_MODE="${LAUNCH_MODE:-hmr}" node "$SCRIPT_DIR/drive.mjs" "$feature") || status=$?
  # drive.mjs exits 2 only for usage errors such as an unknown feature; nothing ran, so keep the DB.
  ((status == 2)) && return 2
  log "restoring seed data"
  cmd_reseed "$RUN_ID" >/dev/null
  return "$status"
}

cmd_cleanup() {
  resolve_run "${1:-}"
  log "cleaning up run $RUN_ID"

  # Keep the launch log with the evidence before scratch state is removed.
  mkdir -p "$EVIDENCE_DIR"
  for f in bin-dev.log db-setup.log smoke.log; do
    [[ -f "$RUN_DIR/$f" ]] && cp "$RUN_DIR/$f" "$EVIDENCE_DIR/launch-$f"
  done

  # Stop bin/dev first: when overmind exits, ReactOnRails::Dev::ProcessManager falls back to
  # foreman and restarts every process, so the parent must already be gone.
  local pid
  for pid in $(owned_role_pids bin-dev); do
    if still_ours "$pid"; then log "stopping bin/dev pid $pid"; kill -TERM "$pid" 2>/dev/null || true; fi
  done
  if [[ -S "$OVERMIND_SOCKET_USED" ]]; then
    log "asking overmind to quit (socket $OVERMIND_SOCKET_USED)"
    overmind quit -s "$OVERMIND_SOCKET_USED" >/dev/null 2>&1 || true
  else
    # Foreman (or an overmind that never opened its socket) stops its children on TERM.
    for pid in $(owned_role_pids process-manager); do
      if still_ours "$pid"; then kill -TERM "$pid" 2>/dev/null || true; fi
    done
  fi

  # Overmind drains its panes (the node renderer exits last) before it and its tmux server stop.
  # After the grace period, signal only recorded processes whose start time still matches.
  local deadline=$((SECONDS + 45)) remaining
  while :; do
    remaining=""
    for pid in $(owned_pids); do still_ours "$pid" && remaining+=" $pid"; done
    [[ -z "$remaining" ]] && break
    if ((SECONDS >= deadline)); then
      log "terminating recorded processes still running:$remaining"
      for pid in $remaining; do kill -TERM "$pid" 2>/dev/null || true; done
      sleep 3
      for pid in $remaining; do still_ours "$pid" && die "recorded pid $pid is still running; inspect it before retrying"; done
      break
    fi
    sleep 1
  done

  local ports=("$RAILS_PORT" "$WEBPACK_PORT" "$RENDERER_PORT_USED") port
  for port in "${ports[@]}"; do
    for pid in $(port_listeners "$port"); do
      echo "verify-flagship: :$port is held by pid $pid, which this run did not start; leaving it alone" >&2
    done
  done
  ports_free "${ports[@]}" || die "ports ${ports[*]} are not free; the listeners above are not ours to stop"

  rm -f "$OVERMIND_SOCKET_USED"
  rm -rf "$RUN_DIR"
  if [[ -f "$VF_DIR/current" && "$(cat "$VF_DIR/current")" == "$RUN_ID" ]]; then rm -f "$VF_DIR/current"; fi

  [[ -d "$EVIDENCE_DIR" ]] || die "evidence directory $EVIDENCE_DIR is missing after cleanup"
  log "ports ${ports[*]} are free; scratch state removed"
  log "evidence kept in $EVIDENCE_DIR:"
  (cd "$EVIDENCE_DIR" && find . -type f | sort)
}

cmd_status() {
  echo "current: $(cat "$VF_DIR/current" 2>/dev/null || echo none)"
  echo "runs:";     /bin/ls -1 "$RUNS_DIR" 2>/dev/null | sed 's/^/  /' || true
  echo "evidence:"; /bin/ls -1 "$EVIDENCE_ROOT" 2>/dev/null | sed 's/^/  /' || true
}

command="${1:-}"
shift || true
case "$command" in
  launch)
    require_tools lsof pgrep curl node sqlite3 overmind tmux
    cmd_launch "$@" ;;
  doctor) require_tools lsof curl node sqlite3; cmd_doctor "$@" ;;
  drive) require_tools lsof curl node sqlite3; cmd_drive "$@" ;;
  reseed) cmd_reseed "$@" ;;
  cleanup) require_tools lsof; cmd_cleanup "$@" ;;
  status) cmd_status ;;
  *) awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"; [[ -z "$command" ]] || exit 1 ;;
esac
